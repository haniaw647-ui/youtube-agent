# Copy to .env and fill in. Never commit .env.
# See docs/ENVIRONMENT.md for the full reference.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Supabase (Postgres + Auth) — project: youtube-automation-platform (yfmgffojwqhodmvvwqsy, us-east-1)
# DATABASE_URL: get from Supabase dashboard > Project Settings > Database > Connection string (URI, use the pooled connection for the app)
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-DB-PASSWORD]@db.yfmgffojwqhodmvvwqsy.supabase.co:5432/postgres
SUPABASE_URL=https://yfmgffojwqhodmvvwqsy.supabase.co
SUPABASE_ANON_KEY=sb_publishable_oN6Muf9UG7NFKEW9n-J12w_DA2E7uZ3
# SUPABASE_SERVICE_ROLE_KEY: get from Supabase dashboard > Project Settings > API — never expose client-side, server-only
SUPABASE_SERVICE_ROLE_KEY=

# Redis (local: docker-compose service name; Railway: injected automatically once the Redis plugin is attached)
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
